            "    vector<int> cnt;",
            "    Trie() { new_node(); }",
            "    int new_node() {",
            "        nxt.push_back({});",
            "        cnt.push_back(0);",
            "        return nxt.size() - 1;",
            "    }",
            "    void insert(const string& s) {",
            "        int u = 0;",
            "        for (char ch : s) {",
            "            int c = ch - 'a';",
            "            if (!nxt[u][c]) {",
            "                int v = new_node();",
            "                nxt[u][c] = v;",
            "            }",
            "            u = nxt[u][c];",
            "        }",
            "        cnt[u]++;",
            "    }",
            "    bool contains(const string& s) {",
            "        int u = 0;",
            "        for (char ch : s) {",
            "            u = nxt[u][ch - 'a'];",
            "            if (!u) return false;",
            "        }",
            "        return cnt[u] > 0;",
            "    }",
            "};"
        ],
        "description": "Trie over lowercase letters with insert / contains"
