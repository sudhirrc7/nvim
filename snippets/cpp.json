    "Topological Sort": {
        "prefix": "cptopo",
        "body": [
            "vector<int> topo_sort(const vector<vector<int>>& adj) {",
            "    int n = adj.size();",
            "    vector<int> indeg(n), order;",
            "    for (auto& e : adj)",
            "        for (int v : e) indeg[v]++;",
            "    queue<int> q;",
            "    for (int i = 0; i < n; i++)",
            "        if (!indeg[i]) q.push(i);",
            "    while (!q.empty()) {",
            "        int u = q.front();",
            "        q.pop();",
            "        order.push_back(u);",
            "        for (int v : adj[u])",
            "            if (!--indeg[v]) q.push(v);",
            "    }",
            "    return order;",
            "}"
        ],
        "description": "Kahn's algorithm; result smaller than n means a cycle"
    },
    "LCA (Binary Lifting)": {
        "prefix": "cplca",
        "body": [
            "struct LCA {",
            "    int LOG;",
            "    vector<vector<int>> up;",
            "    vector<int> depth;",
            "    LCA(const vector<vector<int>>& adj, int root = 0) {",
            "        int n = adj.size();",
            "        LOG = __lg(max(n, 1)) + 1;",
            "        up.assign(LOG, vector<int>(n, root));",
            "        depth.assign(n, 0);",
            "        vector<int> st = {root};",
            "        vector<bool> seen(n);",
            "        seen[root] = true;",
            "        while (!st.empty()) {",
            "            int u = st.back();",
            "            st.pop_back();",
            "            for (int v : adj[u])",
            "                if (!seen[v]) {",
            "                    seen[v] = true;",
            "                    depth[v] = depth[u] + 1;",
            "                    up[0][v] = u;",
            "                    st.push_back(v);",
            "                }",
            "        }",
            "        for (int j = 1; j < LOG; j++)",
            "            for (int v = 0; v < n; v++) up[j][v] = up[j - 1][up[j - 1][v]];",
            "    }",
            "    int lca(int a, int b) {",
            "        if (depth[a] < depth[b]) swap(a, b);",
            "        int diff = depth[a] - depth[b];",
            "        for (int j = 0; j < LOG; j++)",
            "            if (diff >> j & 1) a = up[j][a];",
            "        if (a == b) return a;",
            "        for (int j = LOG - 1; j >= 0; j--)",
            "            if (up[j][a] != up[j][b]) a = up[j][a], b = up[j][b];",
            "        return up[0][a];",
            "    }",
            "    int dist(int a, int b) { return depth[a] + depth[b] - 2 * depth[lca(a, b)]; }",
            "};"
        ],
        "description": "Lowest common ancestor and tree distance"
    },
