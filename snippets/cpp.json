    "nCr (Factorials)": {
        "prefix": "cpncr",
        "body": [
            "const int MAXF = ${1:200005};",
            "const long long MODF = ${2:1000000007};",
            "long long fact[MAXF], inv_fact[MAXF];",
            "",
            "void init_fact() {",
            "    fact[0] = 1;",
            "    for (int i = 1; i < MAXF; i++) fact[i] = fact[i - 1] * i % MODF;",
            "    long long b = fact[MAXF - 1], e = MODF - 2, r = 1;",
            "    for (; e > 0; e >>= 1, b = b * b % MODF)",
            "        if (e & 1) r = r * b % MODF;",
            "    inv_fact[MAXF - 1] = r;",
            "    for (int i = MAXF - 1; i > 0; i--) inv_fact[i - 1] = inv_fact[i] * i % MODF;",
            "}",
            "",
            "long long nCr(int n, int r) {",
            "    if (r < 0 || r > n) return 0;",
            "    return fact[n] * inv_fact[r] % MODF * inv_fact[n - r] % MODF;",
            "}"
        ],
        "description": "Precomputed factorials and inverse factorials for nCr mod p"
    },
