    "Matrix Exponentiation": {
        "prefix": "cpmat",
        "body": [
            "using Matrix = vector<vector<long long>>;",
            "",
            "Matrix mat_mul(const Matrix& a, const Matrix& b, long long mod) {",
            "    int n = a.size(), k = b.size(), m = b[0].size();",
            "    Matrix c(n, vector<long long>(m));",
            "    for (int i = 0; i < n; i++)",
            "        for (int l = 0; l < k; l++)",
            "            if (a[i][l])",
            "                for (int j = 0; j < m; j++) c[i][j] = (c[i][j] + a[i][l] * b[l][j]) % mod;",
            "    return c;",
            "}",
            "",
            "Matrix mat_pow(Matrix a, long long e, long long mod) {",
            "    int n = a.size();",
            "    Matrix r(n, vector<long long>(n));",
            "    for (int i = 0; i < n; i++) r[i][i] = 1;",
            "    for (; e > 0; e >>= 1, a = mat_mul(a, a, mod))",
            "        if (e & 1) r = mat_mul(r, a, mod);",
            "    return r;",
            "}"
        ],
        "description": "Matrix multiply and fast power mod m"
    },
