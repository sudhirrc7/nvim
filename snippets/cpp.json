    "String Hashing": {
        "prefix": "cphash",
        "body": [
            "struct Hash {",
            "    static constexpr uint64_t M = (1ULL << 61) - 1;",
            "    static uint64_t mul(uint64_t a, uint64_t b) {",
            "        __uint128_t c = (__uint128_t)a * b;",
            "        uint64_t r = (uint64_t)(c & M) + (uint64_t)(c >> 61);",
            "        return r >= M ? r - M : r;",
            "    }",
            "    static uint64_t gen_base() {",
            "        mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());",
            "        return uniform_int_distribution<uint64_t>(100000, M - 1)(rng);",
            "    }",
            "    static inline const uint64_t base = gen_base();",
            "    vector<uint64_t> h, p;",
            "    Hash(const string& s) : h(s.size() + 1), p(s.size() + 1) {",
            "        p[0] = 1;",
            "        for (size_t i = 0; i < s.size(); i++) {",
            "            h[i + 1] = (mul(h[i], base) + (unsigned char)s[i]) % M;",
            "            p[i + 1] = mul(p[i], base);",
            "        }",
            "    }",
            "    uint64_t get(int l, int r) { return (h[r] + M - mul(h[l], p[r - l])) % M; }",
            "};"
        ],
        "description": "Polynomial hash mod 2^61-1 with a random base, get(l, r) on [l, r)"
    },
