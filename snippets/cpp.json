    "Segment Tree (Iterative)": {
        "prefix": "cpsegi",
        "body": [
            "template <typename T, typename F>",
            "struct Seg {",
            "    int n;",
            "    vector<T> t;",
            "    T id;",
            "    F f;",
            "    Seg(int n_, T id_, F f_) : n(n_), t(2 * n_, id_), id(id_), f(f_) {}",
            "    void set(int i, T v) {",
            "        for (t[i += n] = v; i > 1; i >>= 1) t[i >> 1] = f(t[i & ~1], t[i | 1]);",
            "    }",
            "    T query(int l, int r) {  // [l, r)",
            "        T resl = id, resr = id;",
            "        for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
            "            if (l & 1) resl = f(resl, t[l++]);",
            "            if (r & 1) resr = f(t[--r], resr);",
            "        }",
            "        return f(resl, resr);",
            "    }",
            "};",
            "// Seg st(n, 0LL, [](long long a, long long b) { return a + b; });"
        ],
        "description": "Generic bottom-up segment tree, query on [l, r)"
