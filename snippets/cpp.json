    "Lazy Segment Tree": {
        "prefix": "cpsegl",
        "body": [
            "struct LazySeg {",
            "    int n;",
            "    vector<long long> t, lz;",
            "    LazySeg(int n_) : n(n_), t(4 * n_), lz(4 * n_) {}",
            "    void apply(int x, int l, int r, long long v) { t[x] += v * (r - l + 1); lz[x] += v; }",
            "    void push(int x, int l, int r) {",
            "        if (!lz[x]) return;",
            "        int m = (l + r) / 2;",
            "        apply(2 * x, l, m, lz[x]);",
            "        apply(2 * x + 1, m + 1, r, lz[x]);",
            "        lz[x] = 0;",
            "    }",
            "    void update(int ql, int qr, long long v, int x, int l, int r) {",
            "        if (qr < l || r < ql) return;",
            "        if (ql <= l && r <= qr) { apply(x, l, r, v); return; }",
            "        push(x, l, r);",
            "        int m = (l + r) / 2;",
            "        update(ql, qr, v, 2 * x, l, m);",
            "        update(ql, qr, v, 2 * x + 1, m + 1, r);",
            "        t[x] = t[2 * x] + t[2 * x + 1];",
            "    }",
            "    long long query(int ql, int qr, int x, int l, int r) {",
            "        if (qr < l || r < ql) return 0;",
            "        if (ql <= l && r <= qr) return t[x];",
            "        push(x, l, r);",
            "        int m = (l + r) / 2;",
            "        return query(ql, qr, 2 * x, l, m) + query(ql, qr, 2 * x + 1, m + 1, r);",
            "    }",
            "    void update(int l, int r, long long v) { update(l, r, v, 1, 0, n - 1); }",
            "    long long query(int l, int r) { return query(l, r, 1, 0, n - 1); }",
            "};"
        ],
        "description": "Range add + range sum with lazy propagation, [l, r] inclusive"
    },
    "Sparse Table": {
        "prefix": "cpsparse",
        "body": [
            "template <typename T>",
            "struct SparseTable {",
            "    vector<vector<T>> st;",
            "    SparseTable(const vector<T>& a) {",
            "        int n = a.size(), k = __lg(max(n, 1)) + 1;",
            "        st.assign(k, a);",
            "        for (int j = 1; j < k; j++)",
            "            for (int i = 0; i + (1 << j) <= n; i++)",
            "                st[j][i] = min(st[j - 1][i], st[j - 1][i + (1 << (j - 1))]);",
            "    }",
            "    T query(int l, int r) {  // [l, r]",
            "        int j = __lg(r - l + 1);",
            "        return min(st[j][l], st[j][r - (1 << j) + 1]);",
            "    }",
            "};"
        ],
        "description": "O(1) range minimum query after O(n log n) build"
    },
    "Dijkstra": {
        "prefix": "cpdij",
        "body": [
            "vector<long long> dijkstra(int src, const vector<vector<pair<int, long long>>>& adj) {",
            "    vector<long long> dist(adj.size(), LLONG_MAX);",
            "    priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<>> pq;",
            "    dist[src] = 0;",
            "    pq.push({0, src});",
            "    while (!pq.empty()) {",
            "        auto [d, u] = pq.top();",
            "        pq.pop();",
            "        if (d != dist[u]) continue;",
            "        for (auto [v, w] : adj[u])",
            "            if (d + w < dist[v]) {",
            "                dist[v] = d + w;",
            "                pq.push({dist[v], v});",
            "            }",
            "    }",
            "    return dist;",
            "}"
        ],
        "description": "Shortest paths with a priority queue, adj[u] = {v, w}"
    },
