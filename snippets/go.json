{
    "CP Template": {
        "prefix": "cptemp",
        "body": [
            "package main",
            "",
            "import (",
            "\t\"bufio\"",
            "\t\"fmt\"",
            "\t\"os\"",
            ")",
            "",
            "var reader = bufio.NewReaderSize(os.Stdin, 1<<20)",
            "var writer = bufio.NewWriterSize(os.Stdout, 1<<20)",
            "",
            "func solve() {",
            "\t${1:var n int}",
            "\t${2:fmt.Fscan(reader, &n)}",
            "\t$0",
            "}",
            "",
            "func main() {",
            "\tdefer writer.Flush()",
            "\tt := 1",
            "\t${3:fmt.Fscan(reader, &t)}",
            "\tfor ; t > 0; t-- {",
            "\t\tsolve()",
            "\t}",
            "}"
        ],
        "description": "bufio reader/writer + multi-test"
    },
    "Fast Int Reader": {
        "prefix": "cpread",
        "body": [
            "func readInt() int {",
            "\tn, c, neg := 0, byte(0), false",
            "\tfor {",
            "\t\tc, _ = reader.ReadByte()",
            "\t\tif c == '-' || (c >= '0' && c <= '9') {",
            "\t\t\tbreak",
            "\t\t}",
            "\t}",
            "\tif c == '-' {",
            "\t\tneg = true",
            "\t\tc, _ = reader.ReadByte()",
            "\t}",
            "\tfor c >= '0' && c <= '9' {",
            "\t\tn = n*10 + int(c-'0')",
            "\t\tc, _ = reader.ReadByte()",
            "\t}",
            "\tif neg {",
            "\t\treturn -n",
            "\t}",
            "\treturn n",
            "}"
        ],
        "description": "readInt() much faster than fmt.Fscan for large input"
    },
    "Modular Arithmetic": {
        "prefix": "cpmod",
        "body": [
            "const MOD = ${1:1_000_000_007}",
            "",
            "func binpow(b, e, m int) int {",
            "\tr := 1",
            "\tb %= m",
            "\tif b < 0 {",
            "\t\tb += m",
            "\t}",
            "\tfor ; e > 0; e >>= 1 {",
            "\t\tif e&1 == 1 {",
            "\t\t\tr = r * b % m",
            "\t\t}",
            "\t\tb = b * b % m",
            "\t}",
            "\treturn r",
            "}"
        ],
        "description": "MOD and binary exponentiation"
    },
    "GCD": {
        "prefix": "cpgcd",
        "body": [
            "func gcd(a, b int) int {",
            "\tfor b != 0 {",
            "\t\ta, b = b, a%b",
            "\t}",
            "\treturn a",
            "}",
            "",
            "func lcm(a, b int) int { return a / gcd(a, b) * b }"
        ],
        "description": "gcd and lcm"
    },
    "DSU": {
        "prefix": "cpdsu",
        "body": [
            "type DSU struct{ parent, size []int }",
            "",
            "func NewDSU(n int) *DSU {",
            "\td := &DSU{make([]int, n), make([]int, n)}",
            "\tfor i := range d.parent {",
            "\t\td.parent[i], d.size[i] = i, 1",
            "\t}",
            "\treturn d",
            "}",
            "",
            "func (d *DSU) Find(x int) int {",
            "\tfor d.parent[x] != x {",
            "\t\td.parent[x] = d.parent[d.parent[x]]",
            "\t\tx = d.parent[x]",
            "\t}",
            "\treturn x",
            "}",
            "",
            "func (d *DSU) Union(a, b int) bool {",
            "\ta, b = d.Find(a), d.Find(b)",
            "\tif a == b {",
            "\t\treturn false",
            "\t}",
            "\tif d.size[a] < d.size[b] {",
            "\t\ta, b = b, a",
            "\t}",
            "\td.parent[b] = a",
            "\td.size[a] += d.size[b]",
            "\treturn true",
            "}"
        ],
        "description": "Union-find with path compression and union by size"
    },
    "Fenwick Tree": {
        "prefix": "cpfen",
        "body": [
            "type Fenwick []int",
            "",
            "func NewFenwick(n int) Fenwick { return make(Fenwick, n+1) }",
            "",
            "func (f Fenwick) Add(i, v int) {",
            "\tfor i++; i < len(f); i += i & -i {",
            "\t\tf[i] += v",
            "\t}",
            "}",
            "",
            "// Sum of [0, i]",
            "func (f Fenwick) Sum(i int) int {",
            "\ts := 0",
            "\tfor i++; i > 0; i -= i & -i {",
            "\t\ts += f[i]",
            "\t}",
            "\treturn s",
            "}"
        ],
        "description": "BIT, 0-indexed point add / prefix sum"
    },
    "Sieve": {
        "prefix": "cpsieve",
        "body": [
            "func sieve(n int) []bool {",
            "\tcomposite := make([]bool, n+1)",
            "\tcomposite[0] = true",
            "\tif n >= 1 {",
            "\t\tcomposite[1] = true",
            "\t}",
            "\tfor i := 2; i*i <= n; i++ {",
            "\t\tif !composite[i] {",
            "\t\t\tfor j := i * i; j <= n; j += i {",
            "\t\t\t\tcomposite[j] = true",
            "\t\t\t}",
            "\t\t}",
            "\t}",
            "\treturn composite",
            "}"
        ],
        "description": "Sieve of Eratosthenes"
    },
    "Dijkstra": {
        "prefix": "cpdij",
        "body": [
            "type Item struct{ d, u int }",
            "type PQ []Item",
            "",
            "func (p PQ) Len() int            { return len(p) }",
            "func (p PQ) Less(i, j int) bool  { return p[i].d < p[j].d }",
            "func (p PQ) Swap(i, j int)       { p[i], p[j] = p[j], p[i] }",
            "func (p *PQ) Push(x interface{}) { *p = append(*p, x.(Item)) }",
            "func (p *PQ) Pop() interface{} {",
            "\told := *p",
            "\tx := old[len(old)-1]",
            "\t*p = old[:len(old)-1]",
            "\treturn x",
            "}",
            "",
            "// adj[u] = [][2]int{{v, w}}",
            "func dijkstra(src int, adj [][][2]int) []int {",
            "\tconst INF = int(1e18)",
            "\tdist := make([]int, len(adj))",
            "\tfor i := range dist {",
            "\t\tdist[i] = INF",
            "\t}",
            "\tdist[src] = 0",
            "\tpq := &PQ{{0, src}}",
            "\tfor pq.Len() > 0 {",
            "\t\tit := heap.Pop(pq).(Item)",
            "\t\tif it.d != dist[it.u] {",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tfor _, e := range adj[it.u] {",
            "\t\t\tif nd := it.d + e[1]; nd < dist[e[0]] {",
            "\t\t\t\tdist[e[0]] = nd",
            "\t\t\t\theap.Push(pq, Item{nd, e[0]})",
            "\t\t\t}",
            "\t\t}",
            "\t}",
            "\treturn dist",
            "}"
        ],
        "description": "Shortest paths with container/heap (add import \"container/heap\")"
    }
}
