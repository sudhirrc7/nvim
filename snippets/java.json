    "Shuffle Sort": {
        "prefix": "cpsort",
        "body": [
            "static void ruffleSort(int[] a) {",
            "    Random rnd = new Random();",
            "    for (int i = a.length - 1; i > 0; i--) {",
            "        int j = rnd.nextInt(i + 1), t = a[i];",
            "        a[i] = a[j];",
            "        a[j] = t;",
            "    }",
            "    Arrays.sort(a);",
            "}"
        ],
        "description": "Shuffle before Arrays.sort to avoid anti-quicksort tests"
    },
    "Modular Arithmetic": {
        "prefix": "cpmod",
        "body": [
            "static final long MOD = ${1:1_000_000_007L};",
            "",
            "static long binpow(long b, long e, long m) {",
            "    long r = 1;",
            "    b %= m;",
            "    if (b < 0) b += m;",
            "    for (; e > 0; e >>= 1, b = b * b % m)",
            "        if ((e & 1) == 1) r = r * b % m;",
            "    return r;",
            "}",
            "",
            "static long modinv(long a) { return binpow(a, MOD - 2, MOD); }"
        ],
        "description": "MOD, binary exponentiation, modular inverse"
    },
    "GCD": {
        "prefix": "cpgcd",
        "body": [
            "static long gcd(long a, long b) { return b == 0 ? a : gcd(b, a % b); }",
            "static long lcm(long a, long b) { return a / gcd(a, b) * b; }"
        ],
        "description": "gcd and lcm"
    },
    "DSU": {
        "prefix": "cpdsu",
        "body": [
            "static class DSU {",
            "    int[] parent, size;",
            "",
            "    DSU(int n) {",
            "        parent = new int[n];",
            "        size = new int[n];",
            "        for (int i = 0; i < n; i++) {",
            "            parent[i] = i;",
            "            size[i] = 1;",
            "        }",
            "    }",
            "",
            "    int find(int x) {",
            "        while (parent[x] != x) x = parent[x] = parent[parent[x]];",
            "        return x;",
            "    }",
            "",
            "    boolean union(int a, int b) {",
            "        a = find(a);",
            "        b = find(b);",
            "        if (a == b) return false;",
            "        if (size[a] < size[b]) { int t = a; a = b; b = t; }",
            "        parent[b] = a;",
            "        size[a] += size[b];",
            "        return true;",
            "    }",
            "}"
        ],
        "description": "Union-find with path compression and union by size"
    },
    "Fenwick Tree": {
        "prefix": "cpfen",
        "body": [
            "static class Fenwick {",
            "    int n;",
            "    long[] t;",
            "",
            "    Fenwick(int n) {",
            "        this.n = n;",
            "        t = new long[n + 1];",
            "    }",
            "",
            "    void add(int i, long v) { for (++i; i <= n; i += i & -i) t[i] += v; }",
            "",
            "    long sum(int i) {  // [0, i]",
            "        long s = 0;",
            "        for (++i; i > 0; i -= i & -i) s += t[i];",
            "        return s;",
            "    }",
            "",
            "    long sum(int l, int r) { return sum(r) - (l > 0 ? sum(l - 1) : 0); }",
            "}"
        ],
        "description": "BIT, 0-indexed point add / prefix sum"
    },
    "Sieve": {
        "prefix": "cpsieve",
        "body": [
            "static boolean[] sieve(int n) {",
            "    boolean[] composite = new boolean[n + 1];",
            "    composite[0] = composite[1] = true;",
            "    for (long i = 2; i * i <= n; i++)",
            "        if (!composite[(int) i])",
            "            for (long j = i * i; j <= n; j += i) composite[(int) j] = true;",
            "    return composite;",
            "}"
        ],
        "description": "Sieve of Eratosthenes"
    },
    "Dijkstra": {
        "prefix": "cpdij",
        "body": [
            "static long[] dijkstra(int src, List<List<long[]>> adj) {",
            "    long[] dist = new long[adj.size()];",
            "    Arrays.fill(dist, Long.MAX_VALUE);",
            "    dist[src] = 0;",
            "    PriorityQueue<long[]> pq = new PriorityQueue<>((x, y) -> Long.compare(x[0], y[0]));",
            "    pq.add(new long[] {0, src});",
            "    while (!pq.isEmpty()) {",
            "        long[] top = pq.poll();",
            "        int u = (int) top[1];",
            "        if (top[0] != dist[u]) continue;",
            "        for (long[] e : adj.get(u)) {",
            "            int v = (int) e[0];",
            "            if (dist[u] + e[1] < dist[v]) {",
            "                dist[v] = dist[u] + e[1];",
            "                pq.add(new long[] {dist[v], v});",
            "            }",
            "        }",
            "    }",
            "    return dist;",
            "}"
        ],
        "description": "Shortest paths with PriorityQueue, adj.get(u) = {v, w}"
    }
}
