    "Bootstrap Recursion": {
        "prefix": "cpboot",
        "body": [
            "from types import GeneratorType",
            "",
            "",
            "def bootstrap(f, stack=[]):",
            "    def wrappedfunc(*args, **kwargs):",
            "        if stack:",
            "            return f(*args, **kwargs)",
            "        to = f(*args, **kwargs)",
            "        while True:",
            "            if type(to) is GeneratorType:",
            "                stack.append(to)",
            "                to = next(to)",
            "            else:",
            "                stack.pop()",
            "                if not stack:",
            "                    break",
            "                to = stack[-1].send(to)",
            "        return to",
            "",
            "    return wrappedfunc",
            "",
            "",
            "# @bootstrap",
            "# def dfs(u, p):",
            "#     for v in adj[u]:",
            "#         if v != p:",
            "#             yield dfs(v, u)",
            "#     yield None"
        ],
        "description": "PyRival bootstrap: deep recursion without stack overflow (use yield)"
    },
