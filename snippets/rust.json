    "Modular Arithmetic": {
        "prefix": "cpmod",
        "body": [
            "const MOD: u64 = ${1:1_000_000_007};",
            "",
            "fn binpow(mut b: u64, mut e: u64, m: u64) -> u64 {",
            "    let mut r = 1;",
            "    b %= m;",
            "    while e > 0 {",
            "        if e & 1 == 1 {",
            "            r = r * b % m;",
            "        }",
            "        b = b * b % m;",
            "        e >>= 1;",
            "    }",
            "    r",
            "}"
        ],
        "description": "MOD and binary exponentiation"
    },
    "GCD": {
        "prefix": "cpgcd",
        "body": [
            "fn gcd(a: u64, b: u64) -> u64 {",
            "    if b == 0 { a } else { gcd(b, a % b) }",
            "}",
            "",
            "fn lcm(a: u64, b: u64) -> u64 {",
            "    a / gcd(a, b) * b",
            "}"
        ],
        "description": "gcd and lcm"
    },
    "DSU": {
        "prefix": "cpdsu",
        "body": [
            "struct Dsu {",
            "    parent: Vec<usize>,",
            "    size: Vec<usize>,",
            "}",
            "",
            "impl Dsu {",
            "    fn new(n: usize) -> Self {",
            "        Dsu { parent: (0..n).collect(), size: vec![1; n] }",
            "    }",
            "",
            "    fn find(&mut self, mut x: usize) -> usize {",
            "        while self.parent[x] != x {",
            "            self.parent[x] = self.parent[self.parent[x]];",
            "            x = self.parent[x];",
            "        }",
            "        x",
            "    }",
            "",
            "    fn union(&mut self, a: usize, b: usize) -> bool {",
            "        let (mut a, mut b) = (self.find(a), self.find(b));",
            "        if a == b {",
            "            return false;",
            "        }",
            "        if self.size[a] < self.size[b] {",
            "            std::mem::swap(&mut a, &mut b);",
            "        }",
            "        self.parent[b] = a;",
            "        self.size[a] += self.size[b];",
            "        true",
            "    }",
            "}"
        ],
        "description": "Union-find with path compression and union by size"
    },
    "Fenwick Tree": {
        "prefix": "cpfen",
        "body": [
            "struct Fenwick {",
            "    t: Vec<i64>,",
            "}",
            "",
            "impl Fenwick {",
            "    fn new(n: usize) -> Self {",
            "        Fenwick { t: vec![0; n + 1] }",
            "    }",
            "",
            "    fn add(&mut self, i: usize, v: i64) {",
            "        let mut i = i + 1;",
            "        while i < self.t.len() {",
            "            self.t[i] += v;",
            "            i += i & i.wrapping_neg();",
            "        }",
            "    }",
            "",
            "    fn sum(&self, i: usize) -> i64 {",
            "        // [0, i]",
            "        let mut i = i + 1;",
            "        let mut s = 0;",
            "        while i > 0 {",
            "            s += self.t[i];",
            "            i -= i & i.wrapping_neg();",
            "        }",
            "        s",
            "    }",
            "}"
        ],
        "description": "BIT, 0-indexed point add / prefix sum"
    },
    "Sieve": {
        "prefix": "cpsieve",
        "body": [
            "fn sieve(n: usize) -> Vec<bool> {",
            "    let mut is_prime = vec![true; n + 1];",
            "    is_prime[0] = false;",
            "    if n >= 1 {",
            "        is_prime[1] = false;",
            "    }",
            "    let mut i = 2;",
            "    while i * i <= n {",
            "        if is_prime[i] {",
            "            let mut j = i * i;",
            "            while j <= n {",
            "                is_prime[j] = false;",
            "                j += i;",
            "            }",
            "        }",
            "        i += 1;",
            "    }",
            "    is_prime",
            "}"
        ],
        "description": "Sieve of Eratosthenes"
    },
    "Dijkstra": {
        "prefix": "cpdij",
        "body": [
            "fn dijkstra(src: usize, adj: &Vec<Vec<(usize, u64)>>) -> Vec<u64> {",
            "    use std::cmp::Reverse;",
            "    use std::collections::BinaryHeap;",
            "    let mut dist = vec![u64::MAX; adj.len()];",
            "    let mut pq = BinaryHeap::new();",
            "    dist[src] = 0;",
            "    pq.push(Reverse((0u64, src)));",
            "    while let Some(Reverse((d, u))) = pq.pop() {",
            "        if d != dist[u] {",
            "            continue;",
            "        }",
            "        for &(v, w) in &adj[u] {",
            "            if d + w < dist[v] {",
            "                dist[v] = d + w;",
            "                pq.push(Reverse((dist[v], v)));",
            "            }",
            "        }",
            "    }",
            "    dist",
            "}"
        ],
        "description": "Shortest paths with BinaryHeap, adj[u] = [(v, w)]"
    }
}
