{
    "CP Template": {
        "prefix": "cptemp",
        "body": [
            "import { readFileSync } from \"fs\";",
            "",
            "const data: string[] = readFileSync(0, \"utf8\").split(/\\\\s+/).filter(Boolean);",
            "let pos = 0;",
            "const next = (): string => data[pos++];",
            "const nextInt = (): number => Number(data[pos++]);",
            "const out: string[] = [];",
            "",
            "function solve(): void {",
            "    ${1:const n = nextInt();}",
            "    $0",
            "}",
            "",
            "let t = ${2:nextInt()};",
            "while (t-- > 0) solve();",
            "console.log(out.join(\"\\\\n\"));"
        ],
        "description": "Read all stdin as tokens, collect output, multi-test"
    },
    "Min Heap": {
        "prefix": "cpheap",
        "body": [
            "class MinHeap<T> {",
            "    private h: T[] = [];",
            "    constructor(private cmp: (a: T, b: T) => number) {}",
            "    get size(): number {",
            "        return this.h.length;",
            "    }",
            "    push(x: T): void {",
            "        const h = this.h;",
            "        h.push(x);",
            "        let i = h.length - 1;",
            "        while (i > 0) {",
            "            const p = (i - 1) >> 1;",
            "            if (this.cmp(h[i], h[p]) >= 0) break;",
            "            [h[i], h[p]] = [h[p], h[i]];",
            "            i = p;",
            "        }",
            "    }",
            "    pop(): T | undefined {",
            "        const h = this.h;",
            "        const top = h[0];",
            "        const last = h.pop();",
            "        if (h.length > 0 && last !== undefined) {",
            "            h[0] = last;",
            "            let i = 0;",
            "            for (;;) {",
            "                const l = 2 * i + 1, r = l + 1;",
            "                let m = i;",
            "                if (l < h.length && this.cmp(h[l], h[m]) < 0) m = l;",
            "                if (r < h.length && this.cmp(h[r], h[m]) < 0) m = r;",
            "                if (m === i) break;",
            "                [h[i], h[m]] = [h[m], h[i]];",
            "                i = m;",
            "            }",
            "        }",
            "        return top;",
            "    }",
            "}"
        ],
        "description": "Generic binary min-heap with comparator"
    },
    "Modular Arithmetic": {
        "prefix": "cpmod",
        "body": [
            "const MOD = ${1:1000000007n};",
            "",
            "function binpow(b: bigint, e: bigint, m: bigint = MOD): bigint {",
            "    let r = 1n;",
            "    b %= m;",
            "    while (e > 0n) {",
            "        if (e & 1n) r = (r * b) % m;",
            "        b = (b * b) % m;",
            "        e >>= 1n;",
            "    }",
            "    return r;",
            "}"
        ],
        "description": "BigInt binary exponentiation"
    },
    "DSU": {
        "prefix": "cpdsu",
        "body": [
            "class DSU {",
            "    parent: number[];",
            "    size: number[];",
            "    constructor(n: number) {",
            "        this.parent = Array.from({ length: n }, (_, i) => i);",
            "        this.size = new Array(n).fill(1);",
            "    }",
            "    find(x: number): number {",
            "        while (this.parent[x] !== x) x = this.parent[x] = this.parent[this.parent[x]];",
            "        return x;",
            "    }",
            "    union(a: number, b: number): boolean {",
            "        a = this.find(a);",
            "        b = this.find(b);",
            "        if (a === b) return false;",
            "        if (this.size[a] < this.size[b]) [a, b] = [b, a];",
            "        this.parent[b] = a;",
            "        this.size[a] += this.size[b];",
            "        return true;",
            "    }",
            "}"
        ],
        "description": "Union-find with path compression and union by size"
    }
}
